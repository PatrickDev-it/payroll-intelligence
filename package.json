{
  "name": "payroll-calculator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "type": "module",
  "description": "Four-country payroll projection engine for Italy, Germany, Spain and France",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test",
    "verify": "npm run typecheck && npm run test && npm run test:e2e",
    "canary": "vitest run src/countries/official-cross-checks.test.ts src/app/_lib/regression.test.ts",
    "rules:matrix": "tsx scripts/regression-matrix.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "next": "16.3.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
